# Supabase project URL (Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable / anon key. Safe to expose to the browser; protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NEVER expose the service-role key to the browser. Server-only, no NEXT_PUBLIC_ prefix.
# Used only for trusted server-side jobs (e.g. admin scripts). Leave unset unless needed.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google AI Studio (Gemini) API key for the financial assistant.
# SERVER-ONLY: deliberately has no NEXT_PUBLIC_ prefix so it is never sent to
# the browser. Get a key at https://aistudio.google.com/apikey
# The assistant is disabled (not broken) when this is unset.
GEMINI_API_KEY=your-gemini-api-key

# Optional: override the Gemini model. Google retires models periodically; a
# retired model returns HTTP 404. Defaults to the current flash model.
# GEMINI_MODEL=gemini-3.6-flash

